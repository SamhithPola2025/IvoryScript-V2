// control_flow.ivc
// Exercises the three control-flow statements the parser supports:
// if, while, and for. Bodies only use print and integer literals.

if (1 < 2) {
    print("if-branch");
}

int count = 0;
while (count < 3) {
    print(count);
    count = count + 1;
}

for (int i = 0; i < 2; i = i + 1;) {
    print("loop");
}
